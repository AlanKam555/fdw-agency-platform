generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  EMPLOYER
  CANDIDATE
}

enum CandidateStatus {
  APPLIED
  SCREENED
  AVAILABLE
  MATCHED
  MOM_SUBMITTED
  APPROVED
  DEPLOYED
  REJECTED
  WITHDRAWN
}

enum Skill {
  INFANT_CARE
  CHILD_CARE
  ELDERLY_CARE
  COOKING
  HOUSEKEEPING
  PET_CARE
  SPECIAL_NEEDS
  DRIVING
}

enum MedicalFitStatus {
  PENDING
  FIT
  UNFIT
}

enum Sex {
  FEMALE
  MALE
  UNSPECIFIED
}

enum MatchDecision {
  SUGGESTED
  STAFF_APPROVED
  STAFF_REJECTED
}

enum InterviewStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
  DECLINED
}

enum DraftKind {
  SOCIAL_POST
  AD_COPY
  PROFILE_BLURB
  CAMPAIGN_COPY
  BLOG_ARTICLE
  NEWSLETTER
  HEADLINE
  SEO_PAGE
}

enum PlacementKind {
  NEW_HIRE
  TRANSFER
  RETURNING
}

enum CareNeed {
  INFANT
  NEWBORN
  ELDERLY
  DEMENTIA
  DISABILITY
  MULTIPLE_CHILDREN
}

enum DraftStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum DocumentKind {
  PASSPORT
  EDUCATIONAL_CERTIFICATE
  MEDICAL
  PHOTO
  EMPLOYER_NRIC
  OTHER
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role
  disabledAt          DateTime?
  totpSecretEnc       String?
  totpPendingSecretEnc String?
  totpEnabledAt       DateTime?
  totpLastStep        Int?
  totpSetupDueAt      DateTime?
  emailVerifiedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  employer            Employer?
  candidate           Candidate?
  auditLogs           AuditLog[]       @relation("actor")
  drafts              MarketingDraft[] @relation("author")
  reviews             MarketingDraft[] @relation("reviewer")
  decisions           Match[]          @relation("decider")
  campaigns           Campaign[]
  utmLinks            UtmLink[]
  weightEdits         MatchWeightProfile[]
  sessions            Session[]
  recoveryCodes       RecoveryCode[]
  emailVerifications  EmailVerification[]
  approvedDocuments   Document[] @relation("documentApprover")
  rejectedDocuments   Document[] @relation("documentRejector")
  assignments         StaffAssignment[]
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  ipHash        String?
  userAgentHash String?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId])
}

model Candidate {
  id                   String            @id @default(cuid())
  userId               String?           @unique
  user                 User?             @relation(fields: [userId], references: [id])
  fullName             String
  email                String?
  phone                String?
  nationality          String
  dateOfBirth          DateTime
  sex                  Sex
  educationYears       Int
  experienceYears      Int
  skills               Skill[]
  languages            String[]
  salaryExpectationSgd Int
  availableFrom        DateTime
  status               CandidateStatus   @default(APPLIED)
  publicBlurb          String            @default("")
  householdExperience  String            @default("")
  internalNotes        String            @default("")
  photoConsent         Boolean           @default(false)
  marketingConsent     Boolean           @default(false)
  aiProcessingConsent  Boolean           @default(false)
  fictional            Boolean           @default(true)
  firstTimeInSingapore Boolean           @default(true)
  pdpaConsentAt        DateTime?
  pdpaConsentVersion   String?
  passportNumberEnc    String?
  finEnc               String?
  medicalNotesEnc      String?
  medicalFitStatus     MedicalFitStatus  @default(PENDING)
  placementKind        PlacementKind     @default(NEW_HIRE)
  careNeeds            CareNeed[]        @default([])
  skillLevels          Json              @default("{}")
  languageLevels       Json              @default("{}")
  redactedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  documents            Document[]
  shortlists           Shortlist[]
  interviews           InterviewRequest[]
  matches              Match[]
  consents             ConsentRecord[]
  drafts               MarketingDraft[]
  placementOutcomes    PlacementOutcome[]
  assignments          StaffAssignment[]

  @@index([status])
  @@index([email])
}

model Employer {
  id                     String    @id @default(cuid())
  userId                 String?   @unique
  user                   User?     @relation(fields: [userId], references: [id])
  fullName               String
  email                  String
  phone                  String
  householdSize          Int
  childrenCount          Int       @default(0)
  youngestChildAge       Int?
  childrenUnder7Count    Int       @default(0)
  measlesVaccinatedUnder7 Boolean?
  elderlyCount           Int       @default(0)
  hasPets                Boolean   @default(false)
  petDetails             String?
  languagesPreferred     String[]
  skillsRequired         Skill[]
  budgetMinSgd           Int
  budgetMaxSgd           Int
  startDate              DateTime
  housingType            String
  addressArea            String
  dateOfBirth            DateTime?
  nricEnc                String?
  isUndischargedBankrupt Boolean?
  firstTimeEmployer      Boolean   @default(true)
  eopCompleted           Boolean   @default(false)
  eopCompletedOn         DateTime?
  notes                  String    @default("")
  marketingConsent       Boolean   @default(false)
  aiProcessingConsent    Boolean   @default(false)
  pdpaConsentAt          DateTime?
  pdpaConsentVersion     String?
  redactedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  requirements           EmployerRequirement[]
  shortlists             Shortlist[]
  interviews             InterviewRequest[]
  matches                Match[]
  placementOutcomes      PlacementOutcome[]
  contracts              ServiceContract[]
}

model EmployerRequirement {
  id         String   @id @default(cuid())
  employerId String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title      String
  payload    Json
  createdAt  DateTime @default(now())
  matches      Match[]
  weightProfile MatchWeightProfile?

  @@index([employerId])
}

model Enquiry {
  id        String   @id @default(cuid())
  kind      String
  name      String
  email     String
  phone     String?
  message     String
  payload     Json?
  source      String   @default("")
  utmSource   String   @default("")
  utmMedium   String   @default("")
  utmCampaign String   @default("")
  utmContent  String   @default("")
  landingPath String   @default("")
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
}

model Shortlist {
  id          String    @id @default(cuid())
  employerId  String
  candidateId String
  employer    Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([employerId, candidateId])
}

model InterviewRequest {
  id              String          @id @default(cuid())
  employerId      String
  candidateId     String
  employer        Employer        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidate       Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status          InterviewStatus @default(REQUESTED)
  preferredWindow String
  staffNote       String          @default("")
  feedback        InterviewFeedback?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employerId])
  @@index([candidateId])
}

model Match {
  id                String        @id @default(cuid())
  requirementId     String
  requirement       EmployerRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId        String
  employer          Employer      @relation(fields: [employerId], references: [id], onDelete: Cascade)
  score             Int?
  eligible          Boolean
  ineligibleReasons String[]
  breakdown         Json
  explanation       String        @default("")
  explanationSource String        @default("template")
  decision          MatchDecision @default(SUGGESTED)
  decidedById       String?
  decidedBy         User?         @relation("decider", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  createdAt         DateTime      @default(now())
  momCase           MomCase?
  placementOutcomes PlacementOutcome[]

  @@unique([requirementId, candidateId])
  @@index([employerId])
}

model MomCase {
  id            String     @id @default(cuid())
  matchId       String     @unique
  match         Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  checklist     Json
  summary       Json
  rulesSnapshot Json
  ready         Boolean
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  reminders     Reminder[]
}

model Reminder {
  id           String              @id @default(cuid())
  momCaseId    String
  momCase      MomCase             @relation(fields: [momCaseId], references: [id], onDelete: Cascade)
  code         String
  kind         String              @default("")
  title        String
  dueHint      String
  dueOn        DateTime?
  done         Boolean             @default(false)
  doneAt       DateTime?
  approvedAt   DateTime?
  approvedById String?
  deliveries   ReminderDelivery[]

  @@index([momCaseId])
  @@index([kind, dueOn])
}

model Document {
  id           String       @id @default(cuid())
  candidateId  String?
  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId   String?
  kind         DocumentKind
  fileName     String
  contentType  String
  byteSize     Int
  storageKey   String
  sha256       String
  uploadedById    String?
  createdAt       DateTime     @default(now())
  reviewedAt      DateTime?
  approvedById    String?
  approvedBy      User?        @relation("documentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?        @relation("documentRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  @@index([candidateId])
  @@index([candidateId, kind])
  @@index([kind, reviewedAt])
  @@index([employerId])
}

model MarketingDraft {
  id          String      @id @default(cuid())
  kind        DraftKind
  title       String
  body        String
  cautions    String      @default("")
  source      String
  status      DraftStatus @default(DRAFT)
  authorId    String
  author      User        @relation("author", fields: [authorId], references: [id])
  reviewerId  String?
  reviewer    User?       @relation("reviewer", fields: [reviewerId], references: [id])
  reviewedAt  DateTime?
  candidateId String?
  candidate    Candidate?  @relation(fields: [candidateId], references: [id])
  channel      String      @default("")
  language     String      @default("en")
  variantGroup String      @default("")
  compliance   Json?
  campaignId   String?
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("actor", fields: [actorId], references: [id])
  /// Copy of the actor id sealed into the hash. Not a foreign key, so deleting the account does not rewrite the chain.
  actorRef   String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ip         String?
  seq        Int?     @unique
  prevHash   String?
  rowHash    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@index([actorId, action, createdAt])
}

model ConsentRecord {
  id            String    @id @default(cuid())
  subjectType   String
  subjectId     String
  purpose       String
  policyVersion String
  granted       Boolean
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  candidateId   String?
  candidate     Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
}

model AgencySetting {
  id           String   @id @default("default")
  eaLicenceNo  String   @default("00C0000")
  personnel    Json     @default("[]")
  brandVoice   String   @default("")
  voiceNotes   String   @default("")
  updatedAt    DateTime @updatedAt
}

model Campaign {
  id        String         @id @default(cuid())
  title     String
  objective String         @default("")
  startsOn  DateTime
  endsOn    DateTime
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  slots     CampaignSlot[]
  drafts    MarketingDraft[]
}

model CampaignSlot {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel      String
  language     String    @default("en")
  scheduledFor DateTime
  title        String    @default("")
  draftId      String?
  createdAt    DateTime  @default(now())

  @@index([campaignId, scheduledFor])
}

model UtmLink {
  id              String   @id @default(cuid())
  label           String
  destinationPath String
  source          String
  medium          String
  campaign        String
  content         String   @default("")
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model TestimonialRequest {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  name           String
  email          String
  status         String    @default("REQUESTED")
  prompt         String    @default("")
  submittedText  String    @default("")
  publishedQuote String    @default("")
  area           String    @default("")
  createdAt      DateTime  @default(now())
  submittedAt    DateTime?
  reviewedAt     DateTime?
}

model MatchWeightProfile {
  id            String              @id @default(cuid())
  requirementId String              @unique
  requirement   EmployerRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  weights       Json
  note          String              @default("")
  updatedById   String?
  updatedBy     User?               @relation(fields: [updatedById], references: [id])
  updatedAt     DateTime            @updatedAt
}

model InterviewFeedback {
  id               String           @id @default(cuid())
  interviewId      String           @unique
  interview        InterviewRequest @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  rating           Int
  outcome          String
  gaps             String[]
  notes            String           @default("")
  suggestedWeights Json?
  appliedAt        DateTime?
  createdById      String
  createdAt        DateTime         @default(now())
}

model ReminderTypeOptIn {
  code        String   @id
  enabled     Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model ReminderDelivery {
  id            String    @id @default(cuid())
  dedupeKey     String    @unique
  reminderId    String?
  reminder      Reminder? @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  kind          String
  dueOn         String
  recipientHash String
  status        String
  driver        String
  createdAt     DateTime  @default(now())

  @@index([kind, createdAt])
}

model EmailSuppression {
  id        String   @id @default(cuid())
  emailHash String   @unique
  createdAt DateTime @default(now())
}

model PublicHolidayAdjustment {
  id          String   @id @default(cuid())
  date        String   @unique
  name        String
  suppressed  Boolean  @default(false)
  note        String   @default("")
  sourceUrl   String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model MomRuleState {
  key            String    @id
  overrideJson   String?
  sourceUrl      String    @default("")
  note           String    @default("")
  lastVerifiedAt DateTime?
  verifiedById   String?
  updatedAt      DateTime  @updatedAt
}

model PlacementOutcome {
  id                   String    @id @default(cuid())
  matchId              String?
  match                Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)
  candidateId          String
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId           String
  employer             Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  startedOn            DateTime
  endedOn              DateTime?
  checkInMonth         Int?
  durationDays         Int
  completion           String
  reasonCategory       String    @default("")
  employerSatisfaction Int
  helperSatisfaction   Int
  notes                String    @default("")
  recordedById         String
  createdAt            DateTime  @default(now())

  @@index([candidateId])
  @@index([employerId])
  @@index([matchId])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum RecordedPaymentMethod {
  BANK_TRANSFER
  PAYNOW
  CASH
  CHEQUE
  OTHER
}

// Record-keeping only. Amounts are integer cents. No card numbers, no processor tokens.
model ServiceContract {
  id          String         @id @default(cuid())
  employerId  String
  employer    Employer       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  reference   String         @unique
  title       String
  status      ContractStatus @default(DRAFT)
  feeCents    Int
  currency    String         @default("SGD")
  startsOn    DateTime
  endsOn      DateTime?
  notes       String         @default("")
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  invoices    Invoice[]

  @@index([employerId])
}

model Invoice {
  id          String        @id @default(cuid())
  contractId  String
  contract    ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number      String        @unique
  status      InvoiceStatus @default(DRAFT)
  amountCents Int
  currency    String        @default("SGD")
  issuedOn    DateTime?
  dueOn       DateTime?
  notes       String        @default("")
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payments    PaymentRecord[]

  @@index([contractId])
}

model PaymentRecord {
  id           String                @id @default(cuid())
  invoiceId    String
  invoice      Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents  Int
  paidOn       DateTime
  method       RecordedPaymentMethod
  reference    String                @default("")
  notes        String                @default("")
  recordedById String
  createdAt    DateTime              @default(now())

  @@index([invoiceId])
}

model AiUsageLog {
  id                  String   @id @default(cuid())
  feature             String
  provider            String
  model               String
  success             Boolean
  latencyMs           Int
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  estimatedCostCents  Int      @default(0)
  estimatedCostMicro  Int      @default(0)
  actorId             String   @default("")
  errorCode           String   @default("")
  createdAt           DateTime @default(now())

  @@index([feature, createdAt])
  @@index([createdAt])
}

/// Retryable object-store deletes. A redaction must not drop the storage key when the delete fails.
model DeletionOutbox {
  id            String   @id @default(cuid())
  storageKey    String
  reason        String
  entityType    String
  entityId      String
  attempts      Int      @default(0)
  lastError     String   @default("")
  status        String   @default("PENDING")
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

model StaffAssignment {
  id          String    @id @default(cuid())
  staffId     String
  staff       User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([staffId, candidateId])
  @@index([candidateId])
}

/// Singleton row locked while an audit hash is appended.
model AuditChainHead {
  id        String   @id @default("head")
  seq       Int      @default(0)
  rowHash   String   @default("")
  updatedAt DateTime @updatedAt
}

/// Preserves the hash link when old audit rows are purged.
model AuditCheckpoint {
  id         String   @id @default(cuid())
  throughSeq Int
  rowHash    String
  reason     String
  createdAt  DateTime @default(now())

  @@index([throughSeq])
}

model AiDailyLedger {
  id            String   @id
  day           String
  scope         String
  reservedMicro Int      @default(0)
  spentMicro    Int      @default(0)
  calls         Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([day, scope])
  @@index([day])
}

model AiReservation {
  id            String   @id
  day           String
  feature       String
  actorId       String
  reservedMicro Int
  status        String
  createdAt     DateTime @default(now())

  @@index([day, status])
}

model EmbeddingCache {
  id          String   @id @default(cuid())
  contentHash String
  model       String
  vector      Json
  createdAt   DateTime @default(now())

  @@unique([contentHash, model])
  @@index([createdAt])
}
