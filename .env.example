# Copy to .env for local development. Never commit real secrets.
# All values below are placeholders for local development only.

# Postgres connection string (Vercel Postgres, Neon, Supabase, or local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/harbourlight?schema=public"

# Signs session cookies. Production requires at least 32 bytes and rejects published placeholders.
# Generate with: npm run secrets:generate
AUTH_SECRET=""

# 32-byte key, base64-encoded, for AES-256-GCM field and document encryption.
# Generate a full set with: npm run secrets:generate
# Losing this key makes stored passport, FIN, NRIC, and medical values unreadable.
# Leave these blank. Production refuses the old published example and any value under 32 bytes.
FIELD_ENCRYPTION_KEY=""
# Optional keyring. Entries are id:base64, comma-separated. FIELD_ENCRYPTION_KEY_ID names the active id.
# When only FIELD_ENCRYPTION_KEY is set, the id is v1.
FIELD_ENCRYPTION_KEY_ID=""
FIELD_ENCRYPTION_KEYS=""

# Public site origin. Used for metadata and origin checks.
APP_URL="http://localhost:3000"

# Session lifetime. Absolute hours cannot exceed 168 (7 days). Blank or non-integer values keep the defaults.
# Staff and admin idle out after SESSION_IDLE_STAFF_MINUTES (default 30, clamped 5–120).
# Employers and helpers idle out after SESSION_IDLE_PORTAL_MINUTES (default 720, clamped 30–1440).
# Zero is not an off switch. Revoked session rows are deleted after SESSION_REVOKED_RETENTION_HOURS (default 24).
SESSION_ABSOLUTE_HOURS="168"
SESSION_IDLE_STAFF_MINUTES="30"
SESSION_IDLE_PORTAL_MINUTES="720"
SESSION_REVOKED_RETENTION_HOURS="24"

# bcrypt cost. Use 12 in production. Tests may set 4.
BCRYPT_COST="12"

# AI providers. Keys stay on the server. Empty keys fall back to the next
# provider in the list, then to a labelled template. Never commit a real key.
# Per feature, comma-separated, first working provider wins:
# AI_MARKETING_PROVIDERS, AI_MATCHING_PROVIDERS, AI_EXPLANATION_PROVIDERS, AI_EMBEDDING_PROVIDERS
AI_PROVIDER="openai"
AI_MODEL=""
AI_TIMEOUT_MS="20000"
AI_MAX_RETRIES="2"
AI_DAILY_BUDGET_CENTS="500"
AI_MAX_CALLS_PER_DAY="200"
AI_USER_DAILY_BUDGET_CENTS="100"
AI_USER_MAX_CALLS_PER_DAY="40"
AI_FEATURE_DAILY_BUDGET_CENTS="250"
AI_FEATURE_MAX_CALLS_PER_DAY="80"
AI_RESERVE_MICRO="100000"
AI_EMBED_RESERVE_MICRO="20000"
AI_PRICE_TABLE_JSON=""
AI_EMBED_MAX_CHARS="600"
AI_EMBED_CONCURRENCY="4"
AI_EMBED_TIMEOUT_MS="20000"
AI_PII_MINIMISATION="true"
AI_REQUIRE_ZERO_RETENTION="false"
AI_ZERO_RETENTION_PROVIDERS=""
STAFF_ASSIGNMENT_REQUIRED="false"
REVEAL_HOURLY_QUOTA="15"
REVEAL_DAILY_QUOTA="40"
DOWNLOAD_HOURLY_QUOTA="30"
DOWNLOAD_DAILY_QUOTA="80"
ALERT_WEBHOOK_URL=""
MFA_FAIL_HOURLY_ALERT="10"
LOCKOUT_HOURLY_ALERT="8"
AUDIT_SINK=""
AUDIT_WEBHOOK_URL=""
AUDIT_S3_BUCKET=""
AUDIT_S3_PREFIX="audit"
AUDIT_S3_OBJECT_LOCK="false"
AUDIT_S3_LOCK_DAYS="365"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
XAI_API_KEY=""
MISTRAL_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_BASE_URL=""
OPENROUTER_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_AWS_REGION="ap-southeast-1"
AI_CUSTOM_BASE_URL=""
AI_CUSTOM_API_KEY=""

# White-label. Unset values keep the fictional Harbourlight demo.
# AGENCY_PERSONNEL is JSON: [{"name":"Amina Rahim","registrationNo":"R1100001"}]
AGENCY_NAME=""
AGENCY_LEGAL_NAME=""
AGENCY_CITY=""
AGENCY_PHONE=""
AGENCY_EMAIL=""
AGENCY_ADDRESS=""
AGENCY_LICENCE_NO=""
AGENCY_PERSONNEL=""
AGENCY_LOGO_URL=""
AGENCY_PRIMARY_COLOUR=""
AGENCY_ACCENT_COLOUR=""
AGENCY_PAPER_COLOUR=""
AGENCY_LOCALES=""
AGENCY_BRAND_VOICE=""

# Optional MOM overrides. Leave empty to keep the transcribed defaults.
# Every value must be verified against current MOM guidance before use.
MOM_FDW_MIN_AGE=""
MOM_FDW_MAX_AGE_EXCLUSIVE=""
MOM_FDW_RENEWAL_MAX_AGE_EXCLUSIVE=""
MOM_FDW_MIN_EDUCATION_YEARS=""
MOM_EMPLOYER_MIN_AGE=""
MOM_EOP_LEAD_WORKING_DAYS=""
MOM_SECURITY_BOND_SGD=""
MOM_MEDICAL_INSURANCE_SGD=""
MOM_MEDICAL_INPATIENT_CENTS=""
MOM_MEDICAL_DAY_SURGERY_CENTS=""
MOM_MEDICAL_COPAY_INSURER_PERCENT=""
MOM_MEDICAL_COPAY_EMPLOYER_PERCENT=""
MOM_MEDICAL_COPAY_THRESHOLD_CENTS=""
MOM_MEDICAL_COPAY_FROM=""
MOM_PERSONAL_ACCIDENT_SGD=""
MOM_SIP_DEADLINE_DAYS=""
# "allow" lets SIP fall on the arrival day. Any other value keeps the default refusal.
MOM_SIP_ARRIVAL_DAY=""
MOM_MEDICAL_EXAM_DEADLINE_DAYS=""
MOM_LEVY_FIRST_MONTHLY_CENTS=""
MOM_LEVY_FIRST_DAILY_CENTS=""
MOM_LEVY_SUBSEQUENT_MONTHLY_CENTS=""
MOM_LEVY_SUBSEQUENT_DAILY_CENTS=""
MOM_LEVY_CONCESSION_MONTHLY_CENTS=""
MOM_LEVY_CONCESSION_DAILY_CENTS=""
MOM_LEVY_CONCESSION_CAP=""
MOM_LEVY_FIRST_START_DAY=""
MOM_LEVY_LATER_START_OFFSET_DAYS=""
MOM_LEVY_PAYMENT_DAY=""
MOM_REST_DAYS_PER_WEEK=""
MOM_REST_DAYS_MIN_PER_MONTH=""
MOM_REST_DAY_COMPENSATION_DAYS=""
MOM_REST_DAY_DEFERRAL_MONTHS=""
MOM_6ME_INTERVAL_MONTHS=""
MOM_6ME_EXEMPT_FROM_AGE=""
MOM_EA_FEE_MONTHS_PER_YEAR=""
MOM_EA_FEE_MAX_MONTHS=""
MOM_EA_FEE_REFUND_PERCENT=""
MOM_EA_FEE_REFUND_WITHIN_MONTHS=""
MOM_REQUIRED_SEX=""
MOM_APPROVED_COUNTRIES=""
MOM_BOND_EXEMPT_NATIONALITIES=""
MOM_PUBLIC_HOLIDAYS=""

# Document storage. "local" is for development only — Vercel disk is ephemeral.
# Production refuses to start on the local driver unless ALLOW_LOCAL_STORAGE=true.
# Use "s3" for AWS S3, Cloudflare R2, or MinIO. The bucket stays private.
# Objects use random keys, SSE-S3 (AES256) or SSE-KMS, and 5-minute download URLs.
STORAGE_DRIVER="local"
ALLOW_LOCAL_STORAGE="false"
STORAGE_LOCAL_DIR="private"
S3_BUCKET=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set for MinIO or R2. Leave empty for AWS. Path-style is on when an endpoint is set,
# unless S3_FORCE_PATH_STYLE is "false" (typical for R2).
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=""
# AES256 (SSE-S3) or aws:kms. KMS requires S3_KMS_KEY_ID.
S3_SSE="AES256"
S3_KMS_KEY_ID=""

# Required in production. 32-byte base64 key, distinct from every field key.
# Local development falls back to the active field key when this is empty.
TOTP_ENCRYPTION_KEY=""
# Days a new staff or admin account may use the desk before an authenticator is required.
MFA_GRACE_DAYS="7"
# Caps the sign-in delay in milliseconds. Leave unset in production. Tests set 0.
LOCKOUT_DELAY_CAP_MS=""

# Bearer token for the reminder and retention cron endpoints.
# Production requires at least 32 bytes and rejects published placeholders.
CRON_SECRET=""
# How many reverse proxies to trust in X-Forwarded-For. 0 uses the rightmost address.
TRUSTED_PROXY_HOPS="0"
# Optional platform header, for example x-real-ip or x-vercel-forwarded-for.
# When set and present, that header wins. Otherwise X-Forwarded-For is used.
CLIENT_IP_HEADER=""
# Hours a confirmation link stays valid. Default 24. Clamped to 1–168.
EMAIL_VERIFY_HOURS="24"
# Public-form bot check. off (default), turnstile, or hcaptcha.
# off is a no-op, including in production. A selected provider fails closed.
BOT_PROTECTION="off"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""

# Reminder email. The driver defaults to "console", which logs a template code and
# a byte count and never logs the address, subject, or body.
# "smtp" needs SMTP_HOST, SMTP_PORT, and EMAIL_FROM. SMTP_USER and SMTP_PASSWORD
# are optional. "resend" needs RESEND_API_KEY and RESEND_FROM (or EMAIL_FROM).
# "ses" needs SES_FROM (or EMAIL_FROM) and SES_REGION. SES uses the default AWS
# credential chain, including AWS_ACCESS_KEY_ID when it is set.
# Nothing is sent unless REMINDERS_SEND=true. A type must also be opted in, or
# that one reminder approved, and the recipient must not have unsubscribed.
EMAIL_DRIVER="console"
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""
RESEND_FROM=""
SES_FROM=""
SES_REGION="ap-southeast-1"
REMINDERS_SEND="false"
# Agency follow-up windows. These are not MOM figures.
REMINDER_PERMIT_LEAD_DAYS="30"
# Helpers are not emailed unless this is "true".
REMINDER_INCLUDE_HELPER="false"
# Optional copy of interview reminders. Leave empty to skip it.
EMAIL_STAFF_INBOX=""
# Signs unsubscribe links. Falls back to AUTH_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=""
# MOM rule rows older than this many days show a stale warning. Default 90.
MOM_RULE_STALE_DAYS="90"

# Rate limiter. "memory" is the default and is per process.
# "upstash" uses the REST URL and token below. "redis" uses REDIS_URL.
# Leave the URLs and tokens empty unless you run that driver.
RATE_LIMIT_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# Retention job at GET /api/cron/retention. "false" reports counts only.
# "true" redacts due helper profiles and deletes due enquiries.
# Audit rows are deleted only when both values are "true".
RETENTION_ENFORCE="false"
RETENTION_PURGE_AUDIT="false"
# Years to keep service contracts, invoices, and payment records before personal data is anonymised. Default 6.
RETENTION_FINANCIAL_YEARS="6"
