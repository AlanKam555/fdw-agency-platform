# Copy to .env for local development. Never commit real secrets.
# All values below are placeholders for local development only.

# Postgres connection string (Vercel Postgres, Neon, Supabase, or local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/harbourlight?schema=public"

# Signs session cookies. Use a long random string in any shared environment.
AUTH_SECRET="replace-with-a-long-random-string"

# 32-byte key, base64-encoded, for AES-256-GCM field and document encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored passport, FIN, NRIC, and medical values unreadable.
FIELD_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# Public site origin. Used for metadata and origin checks.
APP_URL="http://localhost:3000"

# bcrypt cost. Use 12 in production. Tests may set 4.
BCRYPT_COST="12"

# AI providers. Keys stay on the server. Empty keys fall back to the next
# provider in the list, then to a labelled template. Never commit a real key.
# Per feature, comma-separated, first working provider wins:
# AI_MARKETING_PROVIDERS, AI_MATCHING_PROVIDERS, AI_EXPLANATION_PROVIDERS, AI_EMBEDDING_PROVIDERS
AI_PROVIDER="openai"
AI_MODEL=""
AI_TIMEOUT_MS="20000"
AI_MAX_RETRIES="2"
AI_DAILY_BUDGET_CENTS="500"
AI_MAX_CALLS_PER_DAY="200"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
XAI_API_KEY=""
MISTRAL_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_BASE_URL=""
OPENROUTER_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_AWS_REGION="ap-southeast-1"
AI_CUSTOM_BASE_URL=""
AI_CUSTOM_API_KEY=""

# White-label. Unset values keep the fictional Harbourlight demo.
# AGENCY_PERSONNEL is JSON: [{"name":"Amina Rahim","registrationNo":"R1100001"}]
AGENCY_NAME=""
AGENCY_LEGAL_NAME=""
AGENCY_CITY=""
AGENCY_PHONE=""
AGENCY_EMAIL=""
AGENCY_ADDRESS=""
AGENCY_LICENCE_NO=""
AGENCY_PERSONNEL=""
AGENCY_LOGO_URL=""
AGENCY_PRIMARY_COLOUR=""
AGENCY_ACCENT_COLOUR=""
AGENCY_PAPER_COLOUR=""
AGENCY_LOCALES=""
AGENCY_BRAND_VOICE=""

# Optional MOM overrides. Leave empty to keep the transcribed defaults.
# Every value must be verified against current MOM guidance before use.
MOM_FDW_MIN_AGE=""
MOM_FDW_MAX_AGE_EXCLUSIVE=""
MOM_FDW_MIN_EDUCATION_YEARS=""
MOM_EMPLOYER_MIN_AGE=""
MOM_EOP_LEAD_WORKING_DAYS=""
MOM_SECURITY_BOND_SGD=""
MOM_MEDICAL_INSURANCE_SGD=""
MOM_PERSONAL_ACCIDENT_SGD=""
MOM_SIP_DEADLINE_DAYS=""
MOM_MEDICAL_EXAM_DEADLINE_DAYS=""
MOM_REQUIRED_SEX=""
MOM_APPROVED_COUNTRIES=""
MOM_BOND_EXEMPT_NATIONALITIES=""
MOM_PUBLIC_HOLIDAYS=""

# Document storage. "local" is for development only — Vercel disk is ephemeral.
# Production must use "s3" (any S3-compatible bucket: AWS S3, R2, etc.).
STORAGE_DRIVER="local"
# Folder name under ./storage. The local driver is for development only.
STORAGE_LOCAL_DIR="private"
S3_BUCKET=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Bearer token for the reminder and retention cron endpoints. Required in production.
CRON_SECRET="replace-with-a-long-random-string"

# Rate limiter. "memory" is the default and is per process.
# "upstash" uses the REST URL and token below. "redis" uses REDIS_URL.
# Leave the URLs and tokens empty unless you run that driver.
RATE_LIMIT_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# Retention job at GET /api/cron/retention. "false" reports counts only.
# "true" redacts due helper profiles and deletes due enquiries.
# Audit rows are deleted only when both values are "true".
RETENTION_ENFORCE="false"
RETENTION_PURGE_AUDIT="false"
